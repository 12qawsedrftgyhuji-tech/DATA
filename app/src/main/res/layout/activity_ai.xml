<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ai">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar4"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/toolbar_border"
        app:contentInsetEnd="0dp"
        app:contentInsetLeft="0dp"
        app:contentInsetStart="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/schedule"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="일정"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_schedule" />

            <ImageButton
                android:id="@+id/record"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="기록"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_record" />

            <ImageButton
                android:id="@+id/home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="홈"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_home" />

            <ImageButton
                android:id="@+id/ai"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="AI"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_ai" />

            <ImageButton
                android:id="@+id/profile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="프로필"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_profile" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- ===== 버튼 1: 카메라를 이용하여 디지털 기기 인식 ===== -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/BtnTR"
        android:layout_width="330dp"
        android:layout_height="105dp"
        android:layout_marginTop="208dp"
        android:background="@drawable/bg_main_button"
        android:lineHeight="30sp"
        android:paddingStart="120dp"
        android:paddingEnd="20dp"
        android:text="카메라를 이용하여 디지털 기기 인식"
        android:textAllCaps="false"
        android:textColor="#000000"
        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ===== 버튼 2: 디지털 기기에 대해 대화나누기 ===== -->
    <ImageView
        android:id="@+id/iconTR"
        android:layout_width="105dp"
        android:layout_height="105dp"
        android:layout_marginStart="0dp"
        android:contentDescription="카메라"
        android:elevation="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_camera_device"
        app:layout_constraintStart_toStartOf="@id/BtnTR"
        app:layout_constraintTop_toTopOf="@id/BtnTR" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnTa"
        android:layout_width="330dp"
        android:layout_height="105dp"
        android:layout_marginTop="394dp"
        android:background="@drawable/bg_main_button"
        android:lineHeight="30sp"
        android:paddingStart="120dp"
        android:paddingEnd="20dp"
        android:text="디지털 기기에 대해 대화나누기"
        android:textAllCaps="false"
        android:textColor="#000000"
        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/circleTa"
        android:layout_width="105dp"
        android:layout_height="105dp"
        android:layout_marginStart="0dp"
        android:background="@drawable/bg_circle_blue"
        android:elevation="6dp"
        app:layout_constraintStart_toStartOf="@id/btnTa"
        app:layout_constraintTop_toTopOf="@id/btnTa" />

    <ImageView
        android:id="@+id/iconTa"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:contentDescription="대화"
        android:elevation="7dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_chat_device"
        app:layout_constraintBottom_toBottomOf="@id/circleTa"
        app:layout_constraintEnd_toEndOf="@id/circleTa"
        app:layout_constraintStart_toStartOf="@id/circleTa"
        app:layout_constraintTop_toTopOf="@id/circleTa" />

    <!-- ===== 버튼 3: 외부 앱 화면 AI 도움받기 ===== -->
    <Button
        android:id="@+id/btnStartExternalAi"
        android:layout_width="330dp"
        android:layout_height="80dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#2196F3"
        android:text="외부 앱 화면 AI 도움받기"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnTa" />

</androidx.constraintlayout.widget.ConstraintLayout>
